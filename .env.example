# 复制成 .env 后按需修改；.env 已在 .gitignore 中，不提交到 Git。
# docker compose 会读取同目录的 .env 做变量替换。

# SQLite 文件位置：本机直跑用相对路径，容器内用挂载卷
DATABASE_PATH=data/app.db

# 登录凭证有效期（分钟）。想验证过期行为时可以改成 1。
SESSION_TTL_MINUTES=120

# 允许跨域的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 练习账号：首次启动且用户表为空时自动创建，这里只放占位值
SEED_ON_STARTUP=true
SEED_USERNAME=intern
SEED_PASSWORD=intern123456
SEED_DISPLAY_NAME=练习同学
SEED_SAMPLE_TODOS=true

# ---------- 手机验证码（练习用模拟通道，不接真实短信）----------
# 验证码的 HMAC 密钥，正式环境必须换成随机值
APP_SECRET=please-change-me-to-a-random-string
# 开发模式把验证码一起返回给前端，方便自测和演示；上线必须设为 false
SMS_DEBUG_RETURN_CODE=true
# 验证码有效期（秒）
SMS_CODE_TTL_SECONDS=300
# 同一手机号两次发送的最小间隔（秒）
SMS_RESEND_SECONDS=60
# 单个验证码最多允许输错次数
SMS_MAX_ATTEMPTS=5
# 同一手机号 24 小时内最多发送次数
SMS_DAILY_LIMIT=10

# ---------- 模型服务：千问（DashScope 的 OpenAI 兼容模式）----------
# 密钥只放在后端环境变量里，不要提交、不要写进镜像、不要出现在前端。
# 留空时 /agent 不会注册，登录和待办功能仍然可用。
QWEN_API_KEY=
# 兼容模式地址；换成其他 OpenAI 兼容服务时只改这一项
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-plus
# 只读工具一次最多返回多少条待办
AGENT_TOOL_TODO_LIMIT=20
