# 复制成 .env 后按需修改；.env 已在 .gitignore 中，不提交到 Git。
# docker compose 会读取同目录的 .env 做变量替换。

# SQLite 文件位置：本机直跑用相对路径，容器内用挂载卷
DATABASE_PATH=data/app.db

# 登录凭证有效期（分钟）。想验证过期行为时可以改成 1。
SESSION_TTL_MINUTES=120

# 允许跨域的前端来源，多个用英文逗号分隔
CORS_ORIGINS=http://localhost:5173

# 练习账号：首次启动且用户表为空时自动创建，这里只放占位值
SEED_ON_STARTUP=true
SEED_USERNAME=intern
SEED_PASSWORD=intern123456
SEED_DISPLAY_NAME=练习同学
SEED_SAMPLE_TODOS=true
